{
  "name": "niimbot-b1-pdf-printer",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "verify:guardrails": "node scripts/verify-guardrails.mjs",
    "test": "node --test tests/binarizer.test.ts tests/b1Client.test.ts tests/security.test.ts tests/i18n.test.ts tests/samplePdf.test.ts",
    "check": "npm run lint && npx tsc --noEmit && npm run verify:guardrails && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@mmote/niimbluelib": "0.49.1",
    "pdfjs-dist": "6.5.438"
  }
}
